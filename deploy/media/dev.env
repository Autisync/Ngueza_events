# Local development only. Committed on purpose: these are not secrets, they
# are the values tests/media/roundtrip.test.ts defaults to, so the media
# suite runs straight after a clone.
#
#   cd deploy/media && cp dev.env .env && ./wait-ready.sh
#   npm run test:media
#
# NEVER deploy with these. docker-compose.yml refuses to start without an
# explicit MINIO_ROOT_PASSWORD, IMGPROXY_KEY and IMGPROXY_SALT, so a
# production stack cannot inherit them by accident. Use stack.env.example.
MINIO_ROOT_USER=ngueza
MINIO_ROOT_PASSWORD=localdevpassword123
MEDIA_BUCKET=ngueza-media
MEDIA_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
IMGPROXY_KEY=943b421c9eb07c830af81030552c86009268de4e532ba2ee2eab8247c6da0881
IMGPROXY_SALT=520f986b998545b4785e0defbc4f3c1203f22de2374a3d53cb7a7fe9fea309c5
IMGPROXY_PORT=8080
IMGPROXY_CONCURRENCY=4
