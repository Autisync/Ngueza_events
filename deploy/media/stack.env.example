# Portainer -> Stacks -> your stack -> Environment variables.
# Do not commit the filled version.

# --- MinIO -----------------------------------------------------------
MINIO_ROOT_USER=ngueza
MINIO_ROOT_PASSWORD=            # openssl rand -base64 32
MEDIA_BUCKET=ngueza-media
MEDIA_REGION=us-east-1

# The URL the BROWSER uses to reach MinIO. Presigned uploads are signed
# for this exact host — if it does not match, every upload fails with
# SignatureDoesNotMatch and no other clue.
MINIO_PUBLIC_URL=https://media.ngueza.com
MINIO_CONSOLE_URL=https://media-console.ngueza.com
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- imgproxy --------------------------------------------------------
# Both must be hex, 64 characters each:
#   openssl rand -hex 32
IMGPROXY_KEY=
IMGPROXY_SALT=
IMGPROXY_PORT=8080
IMGPROXY_CONCURRENCY=8
