{
  "name": "ngueza",
  "version": "0.1.0",
  "private": true,
  "description": "NGUEZA — plataforma de procura, reserva e gestão de serviços",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:media": "vitest run --project media",
    "test:auth": "vitest run --project auth",
    "db:reset": "./scripts/db-reset.sh",
    "db:test": "./scripts/db-test.sh",
    "schema:dump": "./scripts/schema-dump.sh",
    "gates": "npm run typecheck && npm run test:unit && npm run test:integration && npm run db:test"
  },
  "dependencies": {
    "jose": "^6.2.10",
    "next": "^16.3.3",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
