# ---------------------------------------------------------------------
# NGUEZA — copy to .env.local and fill in. Never commit the filled file.
# Every account below must be owned by NGUEZA, not by an engineer (§45).
# ---------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never reaches the browser

# Postgres.
#
# Use the POOLER host, never db.<ref>.supabase.co — that one resolves to
# IPv6 only, so it fails outright on any host or CI runner without IPv6.
# It will work from your laptop and then not from your deployment.
#
#   transaction mode :6543  the app. lib/db.ts wraps every query in a
#                           transaction, which is exactly what this mode
#                           wants. Verified: SET LOCAL role is adopted
#                           inside the transaction and released after, so
#                           a pooled connection never leaks a role.
#   session mode     :5432  migrations, psql, anything long-lived.
#
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
MIGRATION_DATABASE_URL=

# Media — self-hosted MinIO + imgproxy via Portainer.
# See deploy/media/README.md. Media never touches the app server (§40).
MEDIA_S3_ENDPOINT=http://localhost:9000          # server-side, internal
MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:9000   # what the BROWSER uses — presigning depends on it
MEDIA_BUCKET=ngueza-media
MEDIA_REGION=us-east-1
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
IMGPROXY_PUBLIC_URL=http://localhost:8080
IMGPROXY_KEY=                                     # openssl rand -hex 32
IMGPROXY_SALT=                                    # openssl rand -hex 32

# Transactional email
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=reservas@ngueza.com
EMAIL_FROM_MARKETING=novidades@ngueza.com   # separate identity, separate suppression list

# Signing secret for newsletter confirm / unsubscribe tokens
NEWSLETTER_TOKEN_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Scheduled job authentication (§26 expiry)
CRON_SECRET=
